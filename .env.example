# ==============================================================================
# LendLoop Environment Variables Template
# Copy this file to .env.local and populate with your own project credentials.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_secret"
CLERK_WEBHOOK_SECRET="whsec_placeholder_secret"

# Optional Initial Admin Bootstrap
# The email address below will be automatically assigned the 'admin' role upon first sign-in:
INITIAL_ADMIN_EMAIL="admin@lendloop.org"

# Clerk Route Navigation
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Convex Backend (https://dashboard.convex.dev)
# Set automatically when running `npx convex dev`, or provided manually:
NEXT_PUBLIC_CONVEX_URL="https://fictional-lendloop-123.convex.cloud"
CONVEX_DEPLOYMENT="dev:fictional-lendloop-123"

# n8n Automation & Webhook Integration (Optional for local app, Required for automations)
# Also configure N8N_WEBHOOK_URL and N8N_WEBHOOK_SECRET in your Convex Dashboard Settings -> Environment Variables
N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/borrow-request"
N8N_WEBHOOK_SECRET="lendloop_n8n_hmac_secret_dev"


