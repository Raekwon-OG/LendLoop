# ==============================================================================
# LendLoop n8n Environment Configuration
# ==============================================================================

# Shared HMAC secret for two-way webhook authentication
N8N_WEBHOOK_SECRET="lendloop_n8n_hmac_secret_dev"

# Convex HTTP Actions URL (or local Next.js proxy)
CONVEX_SITE_URL="http://localhost:3000"

# API Key for n8n write-backs into Convex HTTP endpoints
N8N_WRITEBACK_API_KEY="lendloop_writeback_key_dev"

